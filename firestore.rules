rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'keeramangalam6gillies@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isSiteCollection(name) {
      return name in [
        'journey', 'photos', 'videos',
        'reg_attendance', 'reg_movement', 'reg_radio',
        'reg_newspaper', 'reg_visitor', 'reg_reports'
      ];
    }

    match /{collection}/{document} {
      allow read: if isSiteCollection(collection);
      allow create, update, delete: if isSiteCollection(collection) && isAdmin();
    }
  }
}
