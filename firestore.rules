rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isRaweAdmin() {
      return request.auth != null
        && request.auth.token.email == 'keeramangalam6gillies@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Public website visitors can read the RAWE archive; only the verified
    // administrator can create, update, or delete archive records.
    match /raweContent/{documentId} {
      allow read: if true;
      allow create, update, delete: if isRaweAdmin();
    }

    match /raweProfiles/{documentId} {
      allow read: if true;
      allow create, update, delete: if isRaweAdmin();
    }

    // Attendance is publicly viewable; only the verified RAWE administrator can change it.
    match /raweAttendance/{documentId} {
      allow read: if true;
      allow create, update, delete: if isRaweAdmin();
    }

    // Deny access to every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
